function TBaseDAOZeos<T>.Listagem(const aListaLigada: boolean): IDAO<T>;
var aSql: string;
begin
    Result := Self;
    TRttiSQL<T>.New(nil).Fields(FSqlAtributo.Fields)
                        .Join(FSqlAtributo.Join)
                        .Where(FSqlAtributo.Where)
                        .GroupBy(FSqlAtributo.GroupBy)
                        .OrderBy(FSqlAtributo.OrderBy)
                        .Select(aSql);
    FQuery.DataSet.DisableControls;
    FQuery.Open(aSql);
    if aListaLigada then
       TRttiUtils<T>.New(nil).DataSetToEntityList(FQuery.DataSet, FLista);
    FSqlAtributo.Clear;
    FQuery.DataSet.EnableControls;
end;

function TBaseDAOZeos<T>.Listagem(var aLista: TObjectList<T>): IDAO<T>;
var aSql: string;
begin
   Result := Self;
   TRttiSQL<T>.New(nil).Fields(FSqlAtributo.Fields)
                       .Join(FSqlAtributo.Join)
                       .Where(FSqlAtributo.Where)
                       .GroupBy(FSqlAtributo.GroupBy)
                       .OrderBy(FSqlAtributo.OrderBy)
                       .Select(aSql);
   FQuery.Open(aSql);
   if not assigned(aLista) then
      aLista := TObjectList<T>.Create;
   TRttiUtils<T>.New(nil).DataSetToEntityList(FQuery.DataSet, aLista);
   FSqlAtributo.Clear;
end;

function TBaseDAOZeos<T>.Listagem(var aId: integer): T;
var aSql: string;
begin
  Result := T.Create;
  TRttiSQL<T>.New(nil).SelectId(aSql);
  FQuery.SQL.Clear;
  FQuery.SQL.Add(aSql);
  Self.FillParameters(Result, aId);
  FQuery.Open;
end;

