function TBaseDAOZeos<T>.FillParameters(aInstance: T): IDAO<T>;
var key: string;
    DictionaryFields: TDictionary<string, Variant>;
    DictionaryFieldType: TDictionary<string, TFieldType>;
    FieldType: TFieldType;
begin
    DictionaryFields := TDictionary<string, Variant>.Create;
    DictionaryFieldType := TDictionary<string, TFieldType>.Create;
    TRttiUtils<T>.New(aInstance).DictionaryFields(DictionaryFields);
    TRttiUtils<T>.New(aInstance).DictionaryFieldType(DictionaryFieldType);
    try
       for key in DictionaryFields.Keys do
       begin
         if FQuery.Params.FindParam(key) <> nil then
         begin
           if DictionaryFieldType.TryGetValue(key, FieldType) then
              FQuery.Params.ParamByName(key).DataType := FieldType;
           FQuery.Params.ParamByName(key).Value := DictionaryFields.Items[key];
         end;
       end;
    finally
      DictionaryFields.Free;
      DictionaryFieldType.Free;
    end;
end;

function TBaseDAOZeos<T>.Inserir(obj: T): IDAO<T>;
