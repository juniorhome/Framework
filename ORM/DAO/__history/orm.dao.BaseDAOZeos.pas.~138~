  if (FLista.Count > 0) and (FDataSource.DataSet.RecNo - 1 <= FLista.Count) then
  begin
    if Assigned(FForm) then
       TRttiUtils<T>.New(nil).BindClassToForm(FForm, FLista[FDataSource.DataSet.RecNo - 1]);
  end;
end;

